{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PerPlayerKit",
  "description": "Per-player custom PvP kits for Paper and Spigot servers.",
  "colors": {
    "primary": "#1F4145",
    "light": "#A6C2C2",
    "dark": "#0E1B1E"
  },
  "favicon": "/favicon.png",
